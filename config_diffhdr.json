{
    "_comment": "Wan-VACE LoRA fine-tuner. See diffhdr_trainer.py. Paper: arXiv 2604.06161",

    "seed": 42,
    "initial_global_step": 0,

    "batch_size": 1,
    "accum": 4,
    "lr": 1e-4,
    "weight_decay": 1e-4,
    "warmup": 200,
    "max_grad_norm": 1.0,
    "max_steps": 10000,

    "_comment_flow": "Wan VACE flow-matching: x_t = (1-t)*x_clean + t*x_noise, v = x_noise - x_clean. Timestep schedule uses shifted logit-uniform (Wan uses mu shift based on sequence length).",
    "mu_y1": 0.5,
    "mu_y2": 1.15,
    "mu_override": null,
    "mu_sigma": 1.0,

    "uncond_ratio": 0.1,

    "eval_interval": 200,
    "save_every_n_steps": 1000,
    "log_every_n_steps": 10,

    "preview_samples_per_gpu": 1,
    "preview_cfg_scale": 5.0,
    "preview_steps": 30,
    "preview_quality": 95,

    "ckpt_path": "wan-vace-finetune/ckpts",
    "preview_path": "wan-vace-finetune/previews",

    "_comment_models": "Wan-2.1-VACE-14B (diffusers format). VAE in FP32, DiT in BF16.",
    "model_id": "linoyts/Wan-VACE-14B-diffusers",
    "lora_rank": 32,
    "lora_alpha": 32.0,
    "lora_exclude_prefixes": ["patch_embedding", "vace_patch_embedding", "condition_embedder", "proj_out", "norm_out", "scale_shift_table"],

    "lora_checkpoint": null,

    "_comment_loggamma": "Log-Gamma color mapping. gamma=2.2, M=100.0 (configurable).",
    "log_gamma": 2.2,
    "log_gamma_M": 100.0,

    "dataset": {
        "num_frames": 81,
        "fps": 24.0,
        "frame_size": 480,
        "frame_aspect": 1.7778,
        "proj_size": 512,
        "yaw_speed_deg_per_sec": 30.0,
        "pitch_speed_deg_per_sec": 10.0,
        "fov_speed_deg_per_sec": 15.0,
        "roll_max_deg": 0.0,
        "fov_min_deg": 60.0,
        "fov_max_deg": 110.0,
        "pitch_start_std_deg": 10.0,
        "motion_smoothing": "linear",
        "jitter_yaw_deg": 0.5,
        "jitter_pitch_deg": 0.5,
        "jitter_fov_deg": 1.0,
        "hflip": true,
        "ev_range": 2.0,
        "ev_drift_per_sec": 0.5,
        "noise_sigma_s": 0.00085,
        "noise_sigma_c": 0.000015,
        "noise_rho": 0.5,
        "quantize_bits": 8,
        "mask_tau_high": 0.95,
        "mask_tau_low": 0.05,
        "mask_ema_alpha": 0.7,
        "color_temp_jitter": 0.05,
        "caption_json_path": "runs/captions.json",
        "hdr_dir": "runs",
        "hdr_glob": "*_1k.hdr",
        "hdr_max_dim": 1024,
        "num_workers": 4,
        "prefetch_factor": 2
    }
}
