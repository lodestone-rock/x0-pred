{
    "_comment": "Krea-2 (K2) flow-matching fine-tuner with LoRA. See krea2_trainer.py.",

    "seed": 42,
    "initial_global_step": 0,

    "batch_size": 2,
    "accum": 4,
    "lr": 1e-4,
    "weight_decay": 1e-4,
    "warmup": 200,
    "max_grad_norm": 1.0,
    "max_steps": 0,

    "t_mu": 0.5,

    "uncond_ratio": 0.1,

    "eval_interval": 200,
    "save_every_n_steps": 1000,
    "log_every_n_steps": 10,

    "preview_samples_per_gpu": 4,
    "preview_cfg_scale": 4.5,
    "preview_steps": 28,
    "preview_mu": null,
    "preview_quality": 95,

    "ckpt_path": "krea2-finetune/ckpts",
    "preview_path": "krea2-finetune/previews",

    "mmdit_config": "large_wide",
    "encoder_config": "qwen3_vl_4b",

    "ae_model_id": "Qwen/Qwen-Image",
    "encoder_model_id": "Qwen/Qwen3-VL-4B-Instruct",

    "mmdit_checkpoint": null,

    "lora_checkpoint": null,

    "lora_rank": 32,
    "lora_alpha": 32.0,
    "lora_exclude_prefixes": [],

    "parquet_dataloader": {
        "parquet_sources": {
            "my_dataset": {
                "path": "data.parquet",
                "n_samples": null
            }
        },
        "caption_columns": {
            "tags": {"weight": 1.0, "is_tag_based": true}
        },
        "filename_column": "url",
        "width_column": "image_width",
        "height_column": "image_height",
        "loss_weight_column": null,
        "image_folder_path": "",
        "base_resolution": [256, 512, 1024],
        "base_resolution_weights": [1.0, 1.0, 1.0],
        "ratio_cutoff": 2.0,
        "resolution_step": 16,
        "shuffle_tags": true,
        "tag_drop_percentage": 0.0,
        "offset": 0,
        "num_workers": 4,
        "prefetch_factor": 2
    }
}
