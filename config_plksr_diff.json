{
    "seed": 42,
    "initial_global_step": 0,
    "upscale": 2,

    "batch_size": 8,
    "lr": 1e-4,
    "accum": 4,
    "warmup": 500,
    "max_grad_norm": 1.0,

    "t_mu": 0.0,

    "eval_interval": 500,
    "preview_steps": 30,
    "log_every_n_steps": 10,
    "save_every_n_steps": 1000,

    "preview_path": "plksr-diff/previews",
    "ckpt_path": "plksr-diff/ckpts",

    "model_checkpoint": null,

    "use_gan": false,
    "gan_weight": 0.1,
    "disc_lr": 1e-4,
    "disc_checkpoint": null,

    "model_config": {
        "in_ch": 3,
        "dim": 64,
        "n_blocks": 16,
        "kernel_size": 13,
        "split_ratio": 0.25,
        "norm_groups": 4,
        "use_ea": true,
        "dysample": false
    },

    "disc_config": {
        "n_class": 1,
        "dims": [48, 96, 192, 288],
        "blocks": [3, 3, 9, 3],
        "downs": [4, 4, 2, 2],
        "drop_path": 0.02,
        "end_drop": 0.2
    },

    "dataset": {
        "hr_folder": "/path/to/your/hr/images",
        "crop_size": 256,
        "use_hflip": true,
        "use_rot": true,
        "num_workers": 4,
        "prefetch_factor": 2,

        "degradation": {
            "kernel_list": ["iso", "aniso", "generalized_iso", "generalized_aniso", "plateau_iso", "plateau_aniso"],
            "kernel_prob": [0.45, 0.25, 0.12, 0.03, 0.12, 0.03],
            "blur_kernel_size": 21,
            "blur_sigma": [0.2, 3.0],
            "betag_range": [0.5, 4.0],
            "betap_range": [1.0, 2.0],
            "sinc_prob": 0.1,

            "resize_prob": [0.2, 0.7, 0.1],
            "resize_range": [0.15, 1.5],
            "gaussian_noise_prob": 0.5,
            "noise_range": [1, 30],
            "poisson_scale_range": [0.05, 3.0],
            "gray_noise_prob": 0.4,
            "jpeg_range": [30, 95],

            "second_blur_prob": 0.8,
            "blur_sigma2": [0.2, 1.5],
            "betag_range2": [0.5, 4.0],
            "betap_range2": [1.0, 2.0],
            "sinc_prob2": 0.1,
            "resize_prob2": [0.3, 0.4, 0.3],
            "resize_range2": [0.3, 1.2],
            "gaussian_noise_prob2": 0.5,
            "noise_range2": [1, 25],
            "poisson_scale_range2": [0.05, 2.5],
            "gray_noise_prob2": 0.4,
            "jpeg_range2": [30, 95],

            "final_sinc_prob": 0.8
        }
    }
}
